# MPC Environment Variables Template
# Copy this file to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
# Supabase project URL and publishable/anon key. The server never accepts a client-supplied identity.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
# The sample preparation utility expects a 32-byte AES-256 key.
SERVER_ENCRYPTION_KEY=replace-with-a-32-byte-development-key
STORAGE_PROVIDER=local
# Required for STORAGE_PROVIDER=supabase; keep the bucket private.
SUPABASE_STORAGE_BUCKET=samples
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mpc
DATABASE_SSL=disable
DATABASE_POOL_MAX=10
# Browser variables are safe publishable configuration, not service-role secrets.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
VITE_API_BASE=
# Optional Vite development proxy target; defaults to http://localhost:3000.
VITE_BACKEND_URL=http://localhost:3000
# Docker/nginx runtime proxy target; use http://backend:3000 in Compose or the
# deployed backend origin in the frontend service environment.
BACKEND_URL=http://backend:3000
BACKEND_HOST=backend:3000
