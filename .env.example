# MPC Environment Variables Template
# Copy this file to .env for local development. Never commit .env.

NODE_ENV=development
PORT=3000

# In production these are required and must be generated by a secret manager.
# JWT_SECRET must be a long random value; do not reuse it for other services.
JWT_SECRET=replace-with-a-long-random-development-secret
# The sample preparation utility expects a 32-byte AES-256 key. Use a secret
# manager in production and do not use a human-readable phrase.
SERVER_ENCRYPTION_KEY=replace-with-a-32-byte-development-key

# Comma-separated exact browser origins. Do not use a wildcard in production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Phase 1 database foundation. Keep this in local .env only; never expose it
# through Vite or commit it. Production values belong in the Render secret store.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mpc
# Set to disable only for a local non-TLS database. Managed databases normally
# use TLS by default.
DATABASE_SSL=disable
DATABASE_POOL_MAX=10
