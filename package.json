{
  "name": "mpc-beater",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "prepare-samples": "tsx server/scripts/prepareSamples.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\"",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:rollback": "tsx server/db/migrate.ts 0001_multi_tenant_foundation.down.sql",
    "db:seed": "tsx server/db/seed.ts",
    "db:test": "tsx server/db/tests/runDatabaseTests.ts",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "test:auth": "node --import tsx --test server/tests/auth.test.ts",
    "test:api": "node --import tsx --test server/tests/api.test.ts server/tests/storage.test.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "@supabase/supabase-js": "^2.117.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.3.0",
    "idb": "^8.0.2",
    "lucide-react": "^0.475.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
